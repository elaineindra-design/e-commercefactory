# Starter requester password. Change this in Vercel before sharing widely.
REQUESTER_PASSWORD=requester123

# Use a long random string in production.
SESSION_SECRET=replace-with-a-long-random-secret

# Upstash Redis REST credentials (recommended for shared requester/factory data).
# Vercel Marketplace / Upstash can populate equivalent KV_REST_API_* variables too.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
